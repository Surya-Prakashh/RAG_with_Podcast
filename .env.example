# Database Configuration (PostgreSQL / Supabase / Railway or SQLite local fallback)
DATABASE_URL=sqlite+aiosqlite:///./lenny_db.sqlite
# Example PostgreSQL URL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_db

# OpenRouter API Key (Cloud LLM Provider)
OPENROUTER_API_KEY=

# Ollama Configuration (Local LLM Provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Default Provider ("ollama" or "openrouter")
ACTIVE_PROVIDER=ollama
